# Supabase Edge Functions Environment Variables
# Set these in Supabase Dashboard → Edge Functions → [Function Name] → Secrets
# Or in .env file when running locally with: supabase functions serve

# Supabase Configuration (automatically provided by Supabase in production)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT Secret (must match server/.env JWT_SECRET)
JWT_SECRET=generate-a-random-string-with-openssl-rand-hex-32

# CORS
CORS_ORIGIN=https://acodera-crm.netlify.app

# Email
BREVO_API_KEY=your-brevo-api-key
SENDER_EMAIL=noreply@acodera.com

# Seed Endpoint Protection
SEED_SECRET=a-random-secret-for-seed-endpoint

# Automation Endpoint Protection
AUTOMATION_SECRET=a-random-secret-for-automation-triggers

# Direct Database URL (for seed endpoint raw SQL)
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.YOUR-PROJECT.supabase.co:5432/postgres

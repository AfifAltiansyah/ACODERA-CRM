# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Edge Functions URL (production)
# Set this in Netlify dashboard: Site settings → Environment variables
VITE_API_URL=https://your-project.supabase.co/functions/v1/api

# For local development, the Vite proxy (vite.config.js) handles /api -> localhost:3002
# To use the old Express backend locally, set: VITE_API_URL=/api
# To use Supabase Edge Functions locally, start: supabase functions serve
# Then set: VITE_API_URL=http://localhost:54321/functions/v1/api